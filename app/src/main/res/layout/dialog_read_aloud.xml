<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@color/btn_bg_press" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/panel_title"
            style="@style/ReadingPanelTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/ui_reading_controls"
            android:layout_marginHorizontal="3dp" />
        <TextView
            android:id="@+id/panel_done"
            style="@style/ReadingPanelAction"
            android:text="@string/reading_done"
            android:layout_marginHorizontal="3dp" />
    </LinearLayout>
    <TextView
        style="@style/ReadingPanelCaption"
        android:layout_width="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/ui_reading_controls_hint" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/panel_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageView
                    android:id="@+id/iv_play_prev"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/prev_sentence"
                    android:src="@drawable/ic_skip_previous" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <ImageView
                    android:id="@+id/iv_play_pause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/audio_play"
                    android:src="@drawable/ic_play_24dp" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                <ImageView
                    android:id="@+id/iv_play_next"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/next_sentence"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/tv_pre"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/previous_chapter"
                    android:layout_marginHorizontal="3dp" />
                <ImageView
                    android:id="@+id/iv_stop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/stop"
                    android:src="@drawable/ic_stop_black_24dp" />
                <TextView
                    android:id="@+id/tv_next"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/next_chapter"
                    android:layout_marginHorizontal="3dp" />
            </LinearLayout>
            <io.legado.app.ui.book.read.config.ReadSettingSlider
                android:id="@+id/timer_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:title="@string/ui_sleep_timer"
                app:max="180" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/timer_presets"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/set_timer"
                    android:layout_marginHorizontal="3dp" />
                <TextView
                    android:id="@+id/timer_save"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/ui_save_timer"
                    android:layout_marginHorizontal="3dp" />
            </LinearLayout>
            <io.legado.app.lib.theme.view.ThemeSwitch
                android:id="@+id/cb_tts_follow_sys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/flow_sys" />
            <io.legado.app.ui.book.read.config.ReadSettingSlider
                android:id="@+id/speech_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:title="@string/read_aloud_speed"
                app:max="45" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">
                <TextView
                    android:id="@+id/ll_catalog"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/chapter_list"
                    android:layout_marginHorizontal="3dp" />
                <TextView
                    android:id="@+id/ll_main_menu"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/main_menu"
                    android:layout_marginHorizontal="3dp" />
                <TextView
                    android:id="@+id/ll_to_backstage"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/to_backstage"
                    android:layout_marginHorizontal="3dp" />
                <TextView
                    android:id="@+id/ll_setting"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/setting"
                    android:layout_marginHorizontal="3dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
