<?xml version="1.0" encoding="utf-8"?>
<io.legado.app.ui.widget.glass.GlassPageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <io.legado.app.ui.widget.glass.GlassBackdropTarget
        android:id="@+id/main_page_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/configFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </io.legado.app.ui.widget.glass.GlassBackdropTarget>
    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:displayHomeAsUp="true"
        app:title="@string/setting" />
</io.legado.app.ui.widget.glass.GlassPageLayout>
