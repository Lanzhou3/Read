<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <View android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@color/btn_bg_press" />

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">
        <TextView android:id="@+id/panel_title"
            style="@style/ReadingPanelTitle"
            android:text="@string/reading_info"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView android:id="@+id/panel_done"
            style="@style/ReadingPanelAction"
            android:text="@string/reading_done" />
    </LinearLayout>

    <LinearLayout android:id="@+id/panel_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:padding="4dp">
        <TextView android:id="@+id/tab_title"
            style="@style/ReadingPanelTab"
            android:text="@string/body_title" />

        <TextView android:id="@+id/tab_header"
            style="@style/ReadingPanelTab"
            android:text="@string/header" />

        <TextView android:id="@+id/tab_footer"
            style="@style/ReadingPanelTab"
            android:text="@string/footer" />

        <TextView android:id="@+id/tab_color"
            style="@style/ReadingPanelTab"
            android:text="@string/text_color" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/panel_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:id="@+id/section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioGroup android:id="@+id/rg_title_mode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">
                    <io.legado.app.lib.theme.view.ThemeRadioNoButton android:id="@+id/rb_title_mode1"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/title_left" />

                    <io.legado.app.lib.theme.view.ThemeRadioNoButton android:id="@+id/rb_title_mode2"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/title_center" />

                    <io.legado.app.lib.theme.view.ThemeRadioNoButton android:id="@+id/rb_title_mode3"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/title_hide" />
                </RadioGroup>

                <io.legado.app.ui.book.read.config.ReadSettingSlider android:id="@+id/dsb_title_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:max="10"
                    app:title="@string/title_font_size" />

                <io.legado.app.ui.book.read.config.ReadSettingSlider android:id="@+id/dsb_title_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:max="100"
                    app:title="@string/title_margin_top" />

                <io.legado.app.ui.book.read.config.ReadSettingSlider android:id="@+id/dsb_title_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:max="100"
                    app:title="@string/title_margin_bottom" />
            </LinearLayout>

            <LinearLayout android:id="@+id/section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout android:id="@+id/ll_header_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_header_show_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/show_hide"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_header_show"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/ll_header_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_header_left_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/left"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_header_left"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/ll_header_middle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_header_middle_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/middle"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_header_middle"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/ll_header_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_header_right_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/right"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_header_right"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/section_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout android:id="@+id/ll_footer_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_footer_show_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/show_hide"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_footer_show"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/ll_footer_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_footer_left_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/left"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_footer_left"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/ll_footer_middle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_footer_middle_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/middle"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_footer_middle"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/ll_footer_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_footer_right_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/right"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_footer_right"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/section_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout android:id="@+id/ll_tip_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_tip_color_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/text_color"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_tip_color"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/ll_tip_divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginBottom="8dp"
                    android:padding="14dp"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/ll_tip_divider_color_label"
                        style="@style/ReadingPanelText"
                        android:text="@string/tip_divider_color"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView android:id="@+id/tv_tip_divider_color"
                        style="@style/ReadingPanelText"
                        android:gravity="end"
                        android:maxWidth="176dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
