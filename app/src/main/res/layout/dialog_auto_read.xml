<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@color/btn_bg_press" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/panel_title"
            style="@style/ReadingPanelTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/ui_auto_read_title" />
        <TextView
            android:id="@+id/panel_done"
            style="@style/ReadingPanelAction"
            android:text="@string/reading_done" />
    </LinearLayout>
    <TextView
        style="@style/ReadingPanelCaption"
        android:layout_width="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/ui_auto_read_hint" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/panel_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:orientation="vertical">
            <io.legado.app.ui.book.read.config.ReadSettingSlider
                android:id="@+id/speed_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:title="@string/auto_page_speed"
                app:max="119" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp">
                <TextView
                    android:id="@+id/ll_catalog"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/chapter_list"
                    android:layout_marginHorizontal="3dp" />
                <TextView
                    android:id="@+id/ll_main_menu"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/main_menu"
                    android:layout_marginHorizontal="3dp" />
                <TextView
                    android:id="@+id/ll_auto_page_stop"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/stop"
                    android:layout_marginHorizontal="3dp" />
                <TextView
                    android:id="@+id/ll_setting"
                    style="@style/ReadingPanelAction"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/setting"
                    android:layout_marginHorizontal="3dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
