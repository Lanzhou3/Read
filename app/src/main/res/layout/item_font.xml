<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:layout_marginBottom="10dp"
    android:padding="16dp"
    android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/font_name"
            style="@style/ReadingPanelCaption"
            android:text="@string/reading_current_font" />

        <TextView android:id="@+id/tv_font"
            style="@style/ReadingPanelText"
            android:text="@string/reading_font_sample"
            android:textSize="19sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ImageView android:id="@+id/iv_checked"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check"
        android:importantForAccessibility="no" />
</LinearLayout>
