<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical">
        <TextView android:id="@+id/tv_seek_title"
            style="@style/ReadingPanelText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="13sp" />

        <TextView android:id="@+id/tv_seek_value"
            style="@style/ReadingPanelText"
            android:minWidth="48dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical">
        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/iv_seek_reduce"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:contentDescription="@string/reduce"
            android:src="@drawable/ic_reduce" />

        <io.legado.app.lib.theme.view.ThemeSeekBar android:id="@+id/seek_bar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:splitTrack="false"
            android:maxHeight="4dp"
            android:minHeight="4dp" />

        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/iv_seek_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:contentDescription="@string/plus"
            android:src="@drawable/ic_add" />
    </LinearLayout>
</LinearLayout>
